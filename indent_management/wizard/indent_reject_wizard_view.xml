<odoo>
    <record id="view_indent_reject_wizard_form" model="ir.ui.view">
        <field name="name">indent.reject.wizard.form</field>
        <field name="model">indent.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Indent">
                <group>
                    <field name="reason"
                           placeholder="Enter reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
