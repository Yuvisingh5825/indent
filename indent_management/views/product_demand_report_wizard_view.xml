<odoo>
    <record id="view_product_demand_report_wizard" model="ir.ui.view">
        <field name="name">product.demand.report.wizard.form</field>
        <field name="model">product.demand.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Demand Report"
                  create="false"
                  edit="false"
                  delete="false">

                <!-- 👇 THIS IS THE KEY -->
                <sheet>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_generate_report"
                            type="object"
                            string="Generate Report"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>
