<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_monthly_demand_wizard_form" model="ir.ui.view">
    <field name="name">monthly.demand.wizard.form</field>
    <field name="model">monthly.demand.wizard</field>
    <field name="arch" type="xml">
        <form string="Monthly Product Demand">
            <group col="4">
                <field name="month"/>
                <field name="year"/>
            </group>

            <footer>
                <button name="action_view_report"
                        string="View Report"
                        type="object"
                        class="btn-primary"/>

                <button string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>

</odoo>