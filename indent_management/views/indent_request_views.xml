<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_indent_request_form" model="ir.ui.view">
        <field name="name">indent.request.form</field>
        <field name="model">indent.request</field>
        <field name="arch" type="xml">
            <form string="Indent Request">

                <!-- HEADER -->
                <header>

                    <button name="action_submit" type="object"
                        string="Submit"
                        class="btn-primary"
                        invisible="state != 'draft'" />

                    <button name="action_approve" type="object"
                        string="Approve"
                        class="btn-primary"
                        invisible="state != 'submitted'" />

                    <button name="action_open_reject_wizard"
                        type="object"
                        string="Reject"
                        invisible="state != 'submitted'" />

                    <button name="action_create_po"
                        type="object"
                        string="Create RFQ"
                        class="btn-primary"
                        invisible="state != 'approved'" />

                    <button name="action_compare_rfqs"
                        type="object"
                        string="Compare"
                        class="btn-primary"
                        invisible="state != 'rfq'" />

                    <button name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state not in ('approved', 'rfq') or selected_po_id"
                        confirm="Cancel this indent? All its RFQs will be cancelled." />

                    <button name="action_reset_to_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state not in ('rejected', 'cancelled')" />

                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,approved,rfq" />
                </header>


                <sheet>
                    <div class="oe_title">
                        <h1> Purchase Indent
                        </h1>
                    </div>

                    <!-- SMART BUTTONS -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pos" type="object"
                            class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="po_count" widget="statinfo" string="RFQ" />
                        </button>

                    </div>

                    <group col="4" string="Indent Information">

                        <field name="name" readonly="1" />
                        <field name="request_date" />
                        <field name="requester_id" string="Requested By" icon="fa-user" />
                        <field name="department_id" readonly="1" />
                        <field name="dest_location_id" />
                        <field name="priority" widget="priority" />
                        <field name="selected_po_id" invisible="not selected_po_id" />

                    </group>


                    <!-- ITEMS -->
                    <notebook>
                        <page string="Items">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id" />
                                    <field name="description" />
                                    <field name="vendor_ids" widget="many2many_tags"
                                        context="{'default_supplier_rank': 1}" />
                                    <field name="quantity" />
                                    <field name="uom_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <!-- CHATTER -->
                    <chatter />

                </sheet>
            </form>
        </field>
    </record>

    <!-- ================= TREE VIEW ================= -->
    <record id="view_indent_request_tree" model="ir.ui.view">
        <field name="name">indent.request.tree</field>
        <field name="model">indent.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <!-- <field name="product_id" />
                <field name="quantity"  />
                <field name="uom_id" /> -->
                <field name="request_date" />
                <field name="requester_id" />
                <field name="department_id" />
                <field name="state" />

            </list>
        </field>
    </record>

    <!-- ================= ACTION ================= -->
    <record id="action_indent_request" model="ir.actions.act_window">
        <field name="name">Indent Requests</field>
        <field name="res_model">indent.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            {'search_default_active': 1}
        </field>
    </record>

